# ============================================
# Plantilla de variables de entorno
# Copiar a .env y rellenar:  cp .env.example .env
# El .env real NUNCA se sube al repo (está en .gitignore).
# Autor: Ing. Kevin Inofuente Colque - DataPath
# ============================================

# OpenAI (LLM + embeddings)  [REQUERIDA]
# El modelo se configura en model_config/model.yaml, no acá.
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx

# PostgreSQL — memoria + log plano (Supabase)  [REQUERIDAS]
# Las lee chat_history/postgres_store.py
DB_USER=postgres.tu-project-ref
DB_PASSWORD=tu-password-de-la-base
DB_HOST=aws-0-us-east-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres

# Qdrant — base de conocimiento  [QDRANT_URL REQUERIDA]
# Las lee vector_store.py
QDRANT_URL=https://qdrant.tu-dominio.com
QDRANT_API_KEY=tu-api-key-de-qdrant
# Convención: prefijo tenant_id_
QDRANT_COLLECTION=tenant_id_datapath

# BigQuery — dataset público CitiBike  [GOOGLE_APPLICATION_CREDENTIALS REQUERIDA]
# Las lee BigQuery/conexion.py. La clave JSON va en credentials/ (en .gitignore).
GOOGLE_APPLICATION_CREDENTIALS=credentials/service-account.json
# Opcionales (estos son los valores por defecto):
#BIGQUERY_DATA_PROJECT=bigquery-public-data
#BIGQUERY_DATASET=new_york_citibike
#BIGQUERY_LOCATION=US
# Tope de bytes facturados por consulta (2 GB)
#BIGQUERY_MAX_BYTES_BILLED=2147483648
