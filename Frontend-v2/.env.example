# ============================================
# Plantilla de variables de entorno del Frontend-v2 (React + Vite)
# Copiar a .env:  cp .env.example .env
# ============================================

# URL del Backend (FastAPI). Sin barra final.
# El servidor de Vite reenvía /api/* a esta URL (proxy), así el navegador
# no necesita CORS en el Backend.
BACKEND_URL=http://localhost:8000
